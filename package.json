{
  "name": "ui_craft",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "craft": "node inquirer.mjs && pnpm i",
    "predev": "pnpm --filter @core/debug build && pnpm --filter @core/utils build",
    "dev": "storybook dev -p 61000",
    "dev:web": "turbo run watch --concurrency=20",
    "build": "turbo run build",
    "build:storybook": "storybook build -o build/storybook",
    "build:core": "pnpm --filter '@core/*' build && pnpm i",
    "build:story": "turbo run build && storybook build -o build/storybook",
    "update:core": "pnpm build:core && pnpm i",
    "clean": "turbo run clean && rimraf build",
    "clean:hard": "turbo run clean:hard && rimraf build node_modules",
    "ts-check": "tsc --noEmit",
    "test": "turbo run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "catalog:lint",
    "@storybook/addon-a11y": "catalog:dev",
    "@storybook/react-vite": "catalog:dev",
    "esbuild": "catalog:dev",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "rimraf": "catalog:build",
    "storybook": "catalog:dev",
    "tsup": "catalog:build",
    "turbo": "catalog:cli",
    "typescript": "catalog:types",
    "vite": "catalog:dev",
    "inquirer": "catalog:cli",
    "@types/node": "catalog:types"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.13.0"
  }
}
